NODE_ENV=development
PORT=5000
TRUST_PROXY_HOPS=0

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/everkeep
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Frontend origins; comma-separated when more than one
CLIENT_URL=http://localhost:5173

# Optional document storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional AI
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional email notifications
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Optional Twilio WhatsApp notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_SANDBOX=false
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_STATUS_CALLBACK_URL=

# Set false to disable scheduled notification processing
NOTIFICATION_SCHEDULER_ENABLED=true
